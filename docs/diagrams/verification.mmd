---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	verify_macro(verify_macro)
	verify_volume(verify_volume)
	verify_injury(verify_injury)
	merge_issues(merge_issues)
	__end__([<p>__end__</p>]):::last
	__start__ -.-> verify_injury;
	__start__ -.-> verify_macro;
	__start__ -.-> verify_volume;
	merge_issues -.-> __end__;
	verify_injury -.-> merge_issues;
	verify_macro -.-> merge_issues;
	verify_volume -.-> merge_issues;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
