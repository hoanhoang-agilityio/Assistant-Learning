{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // Source-only package: apps/web imports the .ts files directly through
    // Next, so nothing is emitted and imports are extensionless.
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
