# Copy to .env and fill in. Keys are read on the server only.

# --- OpenAI API key ---
# Users enter their own OpenAI key on the /api-key page. The server checks
# it, seals it with this secret (AES-256-GCM), and the browser keeps only the
# sealed key in sessionStorage. Required.
# Generate one with: openssl rand -base64 32
API_KEY_SEAL_SECRET=

# --- Research ---
# Optional. Turns on web research with cited sources (Tavily).
# Without it, research uses only the model's own knowledge.
TAVILY_API_KEY=

# --- Quiz ---
# Required. Secret for sealing the quiz answer key until submit.
# Generate one with: openssl rand -base64 32
QUIZ_SEAL_SECRET=

NEXT_PUBLIC_RUNTIME_URL=/api/copilotkit

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# --- Debugging ---
# Optional, `next dev` only. Logs every AG-UI event the CopilotKit runtime
# streams to the terminal.
COPILOTKIT_DEBUG=false
