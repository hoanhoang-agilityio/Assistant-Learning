# ── PostgreSQL (LangGraph PostgresSaver checkpointer) ─────────────────────────
POSTGRES_USER=pt_ai
POSTGRES_PASSWORD=pt_ai_dev
POSTGRES_DB=pt_ai_core
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pt_ai:pt_ai_dev@localhost:5432/pt_ai_core

# ── LLM providers (Reasoning Sandwich tiers — graph uses tiers, not model names) ──
# STANDARD tier: Supervisor, Research, Fitness
OPENAI_API_KEY=
OPENAI_STANDARD_MODEL=gpt-4o-mini

# XHIGH tier: Planning (OpenAI primary; Anthropic fallback)
# Defaults match settings.py — use gpt-4o / claude-sonnet only if quality needs it
OPENAI_XHIGH_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_XHIGH_MODEL=claude-3-5-haiku-20241022

# ── LangFuse observability ────────────────────────────────────────────────────
# Local docker compose (self-hosted): http://localhost:3000
# Cloud EU: https://cloud.langfuse.com — Cloud US: https://us.cloud.langfuse.com
# Use LANGFUSE_BASE_URL only (keys must come from the same Langfuse instance).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
# Set to false to disable tracing without removing keys
# LANGFUSE_TRACING_ENABLED=false

# ── VFS workspace root ───────────────────────────────────────────────────────
WORKSPACE_ROOT=./src/workspace

# ── Tavily MCP (official pre-built server) ───────────────────────────────────
TAVILY_API_KEY=
TAVILY_MCP_URL=https://mcp.tavily.com/mcp
# Set true to skip real Tavily calls and use deterministic mock research data
MOCK_RESEARCH=false

# Research Agent tuning (defaults aligned with settings.py token-burn limits)
RESEARCH_MAX_SEARCH_ITERATIONS=2
RESEARCH_MAX_TOTAL_SEARCHES=5
RESEARCH_EXTRACT_TOP_K=8
# Comma-separated hostname overrides (empty = built-in whitelist)
RESEARCH_TRUSTED_DOMAINS=

# ── MCP research servers (JSON map of server configs for MultiServerMCPClient) ─
# Example: {"evidence":{"url":"http://localhost:8001/mcp","transport":"streamable_http"}}
MCP_SERVERS_JSON={}

# ── App ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
STREAMLIT_PORT=8501
LOG_LEVEL=INFO

# ── Per-user AI rate limits (UTC day buckets) ────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_USER_ID=anonymous
RATE_LIMIT_DAILY_MAX_REQUESTS_PER_USER=20
RATE_LIMIT_DAILY_MAX_TOKENS_PER_USER=200000
RATE_LIMIT_DAILY_MAX_COST_USD_PER_USER=2.0
