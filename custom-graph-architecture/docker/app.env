# Container-side overrides, layered on top of .env.<APP_ENV> by docker-compose.
#
# The POSTGRES_* values in .env.<APP_ENV> are how the *host* reaches the database
# (localhost:5433). From inside the compose network it is the service name and the
# container's own port. Keeping the two in separate files means neither has to be edited
# to run the other way, and compose stays free of per-variable `environment:` lines.
#
# No secrets belong here — this file is committed.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Compose applies migrations on start; a real deployment runs them as their own step.
RUN_MIGRATIONS=true
