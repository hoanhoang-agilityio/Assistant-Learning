# Copy to .env.development (local) or .env (container) and fill in.
# src/core/configs/config.py is the only module that reads these.

APP_ENV=development
PROJECT_NAME="Fitness Coaching Graph"
VERSION=0.1.0
DEBUG=true
API_V1_STR=/api/v1
ALLOWED_ORIGINS=*

# --- LLM ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-5-mini
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=2000
MAX_LLM_CALL_RETRIES=3
LLM_TOTAL_TIMEOUT=60

GUARD_ENABLED=true
GUARD_SCANNERS=invisible_text,ban_substrings,regex,secrets,token_limit,prompt_injection,toxicity,ban_topics
GUARD_FAIL_FAST=true
GUARD_USE_ONNX=false
GUARD_MAX_INPUT_TOKENS=2048
# ban_substrings and regex are skipped unless you configure them.
GUARD_BANNED_SUBSTRINGS=
GUARD_BANNED_PATTERNS=
GUARD_BANNED_TOPICS=violence,self-harm,weapons,illegal drugs
GUARD_PROMPT_INJECTION_THRESHOLD=0.92
GUARD_TOXICITY_THRESHOLD=0.5
GUARD_BANNED_TOPICS_THRESHOLD=0.6

# --- Graph retry limits (spec §9) --------------------------------------------------
COACH_MAX_RETRIES=3
HITL_MAX_RETRIES=3
QA_MAX_RETRIES=3

# --- Knowledge base / RAG (spec §8) ------------------------------------------------
KNOWLEDGE_EMBEDDER_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_DIM=1536
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MIN_SCORE=0.3
RAGAS_FAITHFULNESS_THRESHOLD=0.9

# --- Auth ----------------------------------------------------------------------------
# Required, minimum 32 characters — the app refuses to start without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Persistence -------------------------------------------------------------------
# Which backend holds the checkpointer and the long-term store: postgres | memory.
# Only postgres survives a restart, so only postgres can resume an interrupt() gate.
PERSISTENCE_BACKEND=postgres

# --- Postgres ----------------------------------------------------------------------
# Host port is 5433 to avoid colliding with a local Postgres; inside the compose
# network the app talks to db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=coaching_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
# DATABASE_URL overrides the POSTGRES_* parts when set.
DATABASE_URL=

# --- Observability -----------------------------------------------------------------
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Rate limiting -------------------------------------------------------------------
# Per-endpoint overrides for the defaults in config.py. Keyed on client IP, which is the
# only identity that exists before a login succeeds.
RATE_LIMIT_DEFAULT="200 per day,50 per hour"
RATE_LIMIT_REGISTER="10 per hour"
RATE_LIMIT_LOGIN="20 per minute"
RATE_LIMIT_REFRESH="30 per hour"

# --- Logging -----------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
